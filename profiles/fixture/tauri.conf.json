{
  "build": {
    "beforeBuildCommand": "just build module-fixture",
    "frontendDist": "../ops/modularity/fixtures/module-fixture/dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "todos",
          "description": "Enables the internal TODO module commands",
          "windows": ["main"],
          "permissions": [
            "shipctl-todos:allow-read-todos",
            "shipctl-todos:allow-toggle-todo",
            "shipctl-todos:allow-add-todo",
            "shipctl-todos:allow-move-todo"
          ]
        },
        {
          "identifier": "fixture",
          "description": "Enables the inert internal module fixture command",
          "windows": ["main"],
          "permissions": ["shipctl-fixture:allow-ping"]
        }
      ]
    }
  }
}
