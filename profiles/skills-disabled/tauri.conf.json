{
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "todos",
          "description": "Enables the internal TODO module commands",
          "windows": [
            "main"
          ],
          "permissions": [
            "shep-todos:allow-read-todos",
            "shep-todos:allow-toggle-todo",
            "shep-todos:allow-add-todo",
            "shep-todos:allow-move-todo"
          ]
        },
        {
          "identifier": "ports",
          "description": "Enables the internal Ports module commands",
          "windows": [
            "main"
          ],
          "permissions": [
            "shep-ports:allow-list-listening-ports",
            "shep-ports:allow-kill-port"
          ]
        },
        {
          "identifier": "git",
          "description": "Enables the internal Git module commands",
          "windows": [
            "main"
          ],
          "permissions": [
            "shep-git:allow-is-git-repo",
            "shep-git:allow-git-init",
            "shep-git:allow-git-current-branch",
            "shep-git:allow-git-list-branches",
            "shep-git:allow-git-push-branch",
            "shep-git:allow-git-list-worktrees",
            "shep-git:allow-git-create-worktree",
            "shep-git:allow-git-status",
            "shep-git:allow-git-changed-files",
            "shep-git:allow-git-file-diff",
            "shep-git:allow-git-file-contents",
            "shep-git:allow-git-list-files",
            "shep-git:allow-git-stage-file",
            "shep-git:allow-git-stage-all",
            "shep-git:allow-git-commit",
            "shep-git:allow-git-unstage-file",
            "shep-git:allow-git-unstage-all",
            "shep-git:allow-git-switch-branch",
            "shep-git:allow-git-create-branch",
            "shep-git:allow-git-diff-stats"
          ]
        },
        {
          "identifier": "assistants",
          "description": "Enables the internal Assistant provider commands",
          "windows": [
            "main"
          ],
          "permissions": [
            "shep-assistants:allow-spawn-assistant-session",
            "shep-assistants:allow-resume-assistant-session",
            "shep-assistants:allow-prepare-assistant-session",
            "shep-assistants:allow-confirm-assistant-session-capture",
            "shep-assistants:allow-try-capture-codex-assistant-session",
            "shep-assistants:allow-fail-assistant-session-capture",
            "shep-assistants:allow-update-assistant-session-placement",
            "shep-assistants:allow-update-assistant-session-label",
            "shep-assistants:allow-discard-assistant-session",
            "shep-assistants:allow-rearm-assistant-session",
            "shep-assistants:allow-list-restorable-assistant-sessions",
            "shep-assistants:allow-take-assistant-session-startup-warning",
            "shep-assistants:allow-begin-assistant-session-preserving-shutdown",
            "shep-assistants:allow-get-models-for-provider",
            "shep-assistants:allow-get-pi-config",
            "shep-assistants:allow-save-pi-settings",
            "shep-assistants:allow-save-pi-api-key",
            "shep-assistants:allow-delete-pi-api-key"
          ]
        },
        {
          "identifier": "usage",
          "description": "Enables the internal Usage module commands",
          "windows": [
            "main"
          ],
          "permissions": [
            "shep-usage:allow-get-all-usage-snapshots",
            "shep-usage:allow-get-usage-snapshot",
            "shep-usage:allow-get-usage-details",
            "shep-usage:allow-get-usage-overview",
            "shep-usage:allow-get-project-alias-review-queue",
            "shep-usage:allow-refresh-usage-data"
          ]
        }
      ]
    }
  }
}
