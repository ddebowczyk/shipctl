{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "shipctl",
  "version": "0.9.6",
  "identifier": "com.cognesy.shipctl",
  "mainBinaryName": "shipctl-ui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "bash ops/build/bin/build-tauri-prerequisites.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Shipctl",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'wasm-unsafe-eval' asset:",
        "connect-src": "ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'unsafe-inline' 'self' asset: http://asset.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:5173",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 https://github.com https://objects.githubusercontent.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: http://localhost:5173",
        "style-src": "'unsafe-inline' 'self' asset: http://asset.localhost http://localhost:5173",
        "font-src": "'self' data: http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/shipctl", "binaries/shipctl-runtime"],
    "resources": {
      "generated/shipctl-headless-runtime.mjs": "shipctl-headless-runtime.mjs",
      "generated/shipctl-headless-runtime-admission.json": "shipctl-headless-runtime-admission.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
